# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Generated run artifacts — heavy + regenerable. The valuable feedback
# (grades.jsonl, baseline.json) is tracked explicitly below.
results/runs/
results/app/

# HED model weights (downloaded on demand, large)
*.caffemodel
*.prototxt
.hatch_models/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep tracked feedback even though results/runs is ignored
!results/grades.jsonl
!results/baseline.json

# Test images kept LOCAL — many are third-party / watermarked photos and this
# repo is public. The harness references them by key; drop your own copies in.
tests/images/*
!tests/images/README.md

# Generated grade exports (from the cockpit Export button)
results/feedback_*
